# ================================
# 飞书应用配置
# ================================
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 飞书多维表格配置
# 多维表格的 App Token（从表格 URL 获取）
FEISHU_BITABLE_APP_TOKEN=xxxxxxxxxxxxxxxxxxxxxx
# 主数据表的 Table ID
FEISHU_BITABLE_TABLE_ID=tblxxxxxxxxxxxxxxxxxx

# 飞书云文档根目录 Token（素材库文件夹的 Token）
FEISHU_FOLDER_TOKEN=xxxxxxxxxxxxxxxxxxxxxx

# ================================
# 阿里百炼配置（ASR 语音转文字）
# ================================
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ASR 模型，默认 paraformer-realtime-v2
DASHSCOPE_ASR_MODEL=paraformer-realtime-v2

# ================================
# 改写服务配置
# ================================
# 当前使用哪个改写 provider（可选：claude / qwen / openai）
REWRITER_PROVIDER=claude

# Claude API
CLAUDE_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-opus-4-5

# 阿里百炼 Qwen（改写备用）
QWEN_MODEL=qwen-max

# OpenAI（改写备用）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# ================================
# 抖音 cookies 配置（二选一，解决反爬问题）
# ================================
# 方案A：cookies 文件（推荐 Docker / 服务器环境）
#   用浏览器插件 "Get cookies.txt LOCALLY" 导出登录态 cookies
#   DOUYIN_COOKIES_FILE=/app/config/douyin_cookies.txt
# 方案B：从本地浏览器直接读取（推荐本地开发）
#   需要在浏览器中登录过抖音，支持 chrome / firefox / safari / edge
#   DOUYIN_COOKIES_BROWSER=chrome
DOUYIN_COOKIES_FILE=
DOUYIN_COOKIES_BROWSER=

# ================================
# 网络代理配置（三选一，不需要则留空）
# ================================
# 方案A：路由器级别分流 → 无需配置，留空即可
# 方案B：NAS 上有 Clash/Singbox 代理软件
#   HTTP_PROXY=http://192.168.1.x:7890
#   HTTPS_PROXY=http://192.168.1.x:7890
# 方案C：双网卡路由 → 留空，在 docker-compose 配置网络
HTTP_PROXY=
HTTPS_PROXY=

# ================================
# 应用配置
# ================================
# 临时文件目录
TMP_DIR=/app/tmp
# 日志级别（DEBUG / INFO / WARNING / ERROR）
LOG_LEVEL=INFO

# 是否启用 Claude CLI 二次改写（仅本地 Mac 开发环境支持，NAS 部署请设为 false）
ENABLE_CLAUDE_CLI=false

# 飞书 March 文件夹 token（poller.py 用，扫该文件夹下所有 docx）
MARCH_FOLDER_TOKEN=
